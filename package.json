{
  "name": "akwaaba-pos-and-retail-os",
  "description": "Offline-First Ghanaian Retail Operating System with GRA VSDC Compliance, MoMo, Dumsor Resilience, and Multi-Branch Warehousing",
  "private": true,
  "version": "1.0.0",
  "author": "Mazonia",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "rm -rf dist release",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "electron:dev": "node ./scripts/electron-dev.cjs",
    "electron:build": "node ./node_modules/electron-builder/cli.js",
    "build:win": "node ./node_modules/vite/bin/vite.js build && node ./node_modules/electron-builder/cli.js --win",
    "build:mac": "node ./node_modules/vite/bin/vite.js build && node ./node_modules/electron-builder/cli.js --mac",
    "build:linux": "node ./node_modules/vite/bin/vite.js build && node ./node_modules/electron-builder/cli.js --linux",
    "cap:sync": "node ./node_modules/@capacitor/cli/bin/capacitor sync",
    "cap:android": "node ./node_modules/@capacitor/cli/bin/capacitor open android",
    "cap:ios": "node ./node_modules/@capacitor/cli/bin/capacitor open ios"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dexie": "^4.4.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
